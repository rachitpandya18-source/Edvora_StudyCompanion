# ==============================================================================
# Edvora Study Companion - Backend Environment Configuration Example
# ==============================================================================

# Gemini AI / LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Database Configuration (PostgreSQL in production, SQLite fallback supported for testing)
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/edvora

# Environment Mode
# Values: 'development', 'test', 'testing', or 'production' (default is fail-closed production)
ENVIRONMENT=development

# JWT Authentication Configuration
# Must be at least 32 characters in production. Do NOT use default or trivial strings.
JWT_SECRET_KEY=generate_a_cryptographically_secure_32_character_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Persistent Storage Paths
UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chroma_db
